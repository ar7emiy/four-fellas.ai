# Instagram Reels API requires a public HTTPS URL to the .mp4
# Upload output/<job>/short.mp4 to S3/GCS/your CDN, then set this per run.
IG_PUBLIC_VIDEO_URL=

# TikTok Content Posting API (requires approved app + user OAuth)
TIKTOK_ACCESS_TOKEN=
