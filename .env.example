# AI Influencer Studio — environment template
# Copy to .env and fill in. Production values live in GCP Secret Manager.

# GCP
AISTUDIO_GCP_PROJECT=ai-influencer-studio-dev
AISTUDIO_GCS_BUCKET=ai-influencer-studio-dev
AISTUDIO_CLOUD_SQL_DSN=postgresql+psycopg://localhost/ai_studio

# Anthropic (caption writer)
AISTUDIO_ANTHROPIC_API_KEY=

# Modal (serverless ComfyUI + LoRA training)
# Get from: modal.com → Settings → API Tokens
AISTUDIO_MODAL_TOKEN_ID=
AISTUDIO_MODAL_TOKEN_SECRET=

# ComfyUI local dev (optional — leave blank to use Modal)
# Set to http://localhost:8188 if running ComfyUI locally
COMFYUI_LOCAL_URL=

# fal.ai (Kling video, optional Flux fallback)
AISTUDIO_FAL_API_KEY=

# Meta / Instagram Graph API (per-persona tokens kept in Secret Manager)
AISTUDIO_META_APP_ID=
AISTUDIO_META_APP_SECRET=

# Behavior
AISTUDIO_LOG_LEVEL=INFO
AISTUDIO_CANDIDATE_COUNT_DEFAULT=8
