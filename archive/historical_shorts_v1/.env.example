# Claude (required)
ANTHROPIC_API_KEY=sk-ant-...

# Voice (optional; falls back to offline pyttsx3 if missing)
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=ErXwobaYiN019PkySvjV

# YouTube Data API v3
# Download client_secrets.json from Google Cloud Console (OAuth Desktop client)
YOUTUBE_CLIENT_SECRETS=client_secrets.json
