# AI Influencer Studio — environment template
# Stack: Modal (GPU + compute) + Supabase (DB + storage). That's it.
# Copy to .env and fill in values.

# ── Database ──────────────────────────────────────────────────────────────────
# Phase 0-1: leave as SQLite (zero setup, works out of the box)
# Phase 2+:  swap to Supabase Postgres URL (supabase.com → project → Settings → Database)
AISTUDIO_DATABASE_URL=sqlite:///./studio.db

# ── Supabase (Phase 2+) ───────────────────────────────────────────────────────
# Used for: Postgres DB + generated image storage
# Get from: supabase.com → project → Settings → API
AISTUDIO_SUPABASE_URL=
AISTUDIO_SUPABASE_KEY=

# ── Modal (GPU compute) ───────────────────────────────────────────────────────
# Used for: ComfyUI inference, LoRA training, cron scheduling
# Get from: modal.com → Settings → API Tokens
# Or run:   modal token set --token-id <id> --token-secret <secret>
AISTUDIO_MODAL_TOKEN_ID=
AISTUDIO_MODAL_TOKEN_SECRET=

# Local ComfyUI override (dev only — skip Modal and hit localhost instead)
COMFYUI_LOCAL_URL=

# ── External APIs ─────────────────────────────────────────────────────────────
AISTUDIO_ANTHROPIC_API_KEY=   # console.anthropic.com
AISTUDIO_FAL_API_KEY=         # fal.ai/dashboard (Kling video + fallback generation)

# ── Instagram / Meta ──────────────────────────────────────────────────────────
# Per-persona IG tokens are stored as Modal Secrets (not here).
# Only the app credentials go in .env.
AISTUDIO_META_APP_ID=
AISTUDIO_META_APP_SECRET=

# ── Behaviour ─────────────────────────────────────────────────────────────────
AISTUDIO_LOG_LEVEL=INFO
AISTUDIO_CANDIDATE_COUNT_DEFAULT=8
